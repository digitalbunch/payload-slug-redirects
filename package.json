{
  "name": "payload-slug-redirects",
  "version": "2.0.2",
  "description": "PayloadCMS plugin that automatically creates slug redirects when document slugs change",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    },
    "./next/app": {
      "types": "./dist/next/app/index.d.ts",
      "import": "./dist/next/app/index.js",
      "require": "./dist/next/app/index.cjs"
    },
    "./next/pages": {
      "types": "./dist/next/pages/index.d.ts",
      "import": "./dist/next/pages/index.js",
      "require": "./dist/next/pages/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "payloadcms",
    "payload-plugin",
    "slug",
    "redirects",
    "seo",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalbunch/payload-slug-redirects"
  },
  "bugs": "https://github.com/digitalbunch/payload-slug-redirects/issues",
  "homepage": "https://github.com/digitalbunch/payload-slug-redirects#readme",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "size-limit",
    "size:check": "size-limit --json"
  },
  "size-limit": [
    { "path": "dist/index.js" },
    { "path": "dist/next/index.js" },
    { "path": "dist/next/app/index.js" },
    { "path": "dist/next/pages/index.js" }
  ],
  "peerDependencies": {
    "next": ">=14.0.0",
    "payload": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "next": "^16.4.5",
    "oxlint": "^1.92.0",
    "payload": "^3.93.0",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
